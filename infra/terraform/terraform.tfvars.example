aws_region      = "us-east-2"
environment     = "production"
project_name    = "ai-engineer-knowledge-engine"
vpc_cidr        = "10.40.0.0/16"
api_origin_port = 8000
postgresql_port = 5432

database_name                  = "knowledge_engine"
database_master_username       = "knowledge_admin"
database_engine_version        = "16.14"
database_instance_class        = "db.t4g.micro"
database_allocated_storage_gib = 20
database_max_storage_gib       = 50
database_backup_retention_days = 7
